{
  "lexicon": 1,
  "id": "test.golden.chat.sendMessage",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "A procedure with a default proxy and a closed union input field.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["message"],
          "properties": { "message": { "type": "union", "refs": ["test.golden.embed#images", "test.golden.embed#external"], "closed": true } }
        }
      },
      "output": { "encoding": "application/json", "schema": { "type": "object", "properties": { "id": { "type": "string" } } } }
    }
  }
}
