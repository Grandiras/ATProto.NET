{
  "lexicon": 1,
  "id": "test.golden.subscribe",
  "defs": {
    "main": {
      "type": "subscription",
      "description": "A subscription: its message union is SubscribeMessage.",
      "parameters": { "type": "params", "properties": { "cursor": { "type": "integer" } } },
      "message": { "schema": { "type": "union", "refs": ["#commit", "#info"] } },
      "errors": [{ "name": "FutureCursor" }]
    },
    "commit": { "type": "object", "required": ["seq", "since"], "nullable": ["since"], "properties": { "seq": { "type": "integer" }, "since": { "type": "string", "format": "tid" } } },
    "info": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "knownValues": ["OutdatedCursor"] } } }
  }
}
