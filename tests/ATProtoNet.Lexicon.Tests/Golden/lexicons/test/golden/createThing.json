{
  "lexicon": 1,
  "id": "test.golden.createThing",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "A procedure whose input is all optional and whose output is a ref.",
      "input": {
        "encoding": "application/json",
        "schema": { "type": "object", "properties": { "name": { "type": "string" }, "swap": { "type": "string", "format": "cid" } }, "nullable": ["swap"] }
      },
      "output": { "encoding": "application/json", "schema": { "type": "ref", "ref": "test.golden.defs#strongRef" } }
    }
  }
}
