<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Lexicon tooling: the emitter (CodeGen), the atproto-lexgen CLI, and the generated code itself. The build
       generates every vendored Lexicon family with the CLI and compiles it here, against the Xrpc/Auth stubs in Stubs/
       until phase 5 and 6 bring the real types (LEX-28, phase 3 gate). Warnings are errors, so generated code compiles
       with zero diagnostics. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);ATPROTO002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ATProtoNet\ATProtoNet.csproj" />
    <ProjectReference Include="..\..\tools\ATProtoNet.Lexicon.CodeGen\ATProtoNet.Lexicon.CodeGen.csproj" />
    <ProjectReference Include="..\..\tools\ATProtoNet.Lexicon.Cli\ATProtoNet.Lexicon.Cli.csproj" />
    <ProjectReference Include="..\ATProtoNet.TestKit\ATProtoNet.TestKit.csproj" />
  </ItemGroup>

  <!-- Every vendored Lexicon, generated by the CLI just built, compiled into this assembly. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <VendoredLexicon Include="$(RepoRoot)lexicons/**/*.json;$(RepoRoot)lexgen.json;$(RepoRoot)lexicons.json" />
  </ItemGroup>
  <Target Name="GenerateVendoredLexicons" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <GeneratedLexicons>$(ProjectDir)$(IntermediateOutputPath)lexicons/</GeneratedLexicons>
      <LexgenCli>@(_ResolvedProjectReferencePaths->WithMetadataValue('Filename', 'ATProtoNet.Lexicon.Cli'))</LexgenCli>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(LexgenCli)&quot; generate --clean --out &quot;$(GeneratedLexicons)&quot;" WorkingDirectory="$(RepoRoot)" />
    <ItemGroup>
      <Compile Include="$(GeneratedLexicons)**/*.g.cs" />
      <FileWrites Include="$(GeneratedLexicons)**/*" />
    </ItemGroup>
  </Target>

</Project>
