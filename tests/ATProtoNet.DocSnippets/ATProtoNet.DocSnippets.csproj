<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles every ```csharp block of README.md and docs/*.md (see
       ATProtoNet.DocSnippets.Generator), so a sample that drifts from the API breaks the build.
       Nothing here runs: samples that need a network only have to compile. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\README.md" />
    <AdditionalFiles Include="..\..\docs\*.md" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\ATProtoNet.DocSnippets.Generator\ATProtoNet.DocSnippets.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ATProtoNet\ATProtoNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a web application has in scope without asking, plus the namespaces nearly every
         sample uses. A sample that needs any other namespace says so with its own `using`. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Text.Json" />
  </ItemGroup>

</Project>
