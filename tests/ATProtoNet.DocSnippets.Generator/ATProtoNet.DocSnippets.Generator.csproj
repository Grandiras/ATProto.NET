<Project Sdk="Microsoft.NET.Sdk">

  <!-- The source generator that turns the ```csharp blocks of README.md and docs/*.md into
       code for ATProtoNet.DocSnippets to compile. The compiler loads generators into its own
       process, so this targets netstandard2.0 like every Roslyn component. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/Directory.Build.props adds a global `using Xunit;` this project has no use for. -->
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
