<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAspireHost>true</IsAspireHost>
    <!-- The PDS secrets are persisted here, so accounts survive a restart. -->
    <UserSecretsId>atprotonet-managed-pds-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ATProtoNet.Aspire.Hosting\ATProtoNet.Aspire.Hosting.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\ManagedPdsSample\ManagedPdsSample.csproj" />
  </ItemGroup>

</Project>
