@page "/profile"
@using ATProtoNet.Identity
@attribute [Authorize]

<PageTitle>Profile — ATProto.NET</PageTitle>

<h1>Your Profile</h1>
<p class="text-muted mb-4">
    This page renders <code>&lt;ProfileCard&gt;</code>, which fetches your Bluesky profile from
    the server as you, through the scoped client <code>AddAtProtoBlazor()</code> registers.
</p>

<div style="max-width: 600px;">
    @if (_did is not null)
    {
        <ProfileCard Actor="_did" />
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private AtIdentifier? _did;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (Did.TryParse(user.FindFirst(AtProtoClaimTypes.Did)?.Value, out var did))
            _did = did;
    }
}
