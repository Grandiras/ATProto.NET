@page "/timeline"
@attribute [Authorize]

<PageTitle>Timeline — ATProto.NET</PageTitle>

<h1>Your Timeline</h1>
<p class="text-muted mb-4">
    This page renders <code>&lt;ComposePost&gt;</code> and <code>&lt;FeedView&gt;</code>. Both act
    as you on the server, so no tokens are exposed to the browser; liking or reposting a post
    goes through the same client.
</p>

<div style="max-width: 650px;" class="d-flex flex-column gap-3">
    <ComposePost OnPostCreated="OnPostCreated" />

    @* A new key starts the feed afresh, so the post just made shows at the top. *@
    <FeedView @key="_feedVersion" PageSize="20" />
</div>

@code {
    private int _feedVersion;

    private void OnPostCreated(ATProtoNet.RecordRef post) => _feedVersion++;
}
