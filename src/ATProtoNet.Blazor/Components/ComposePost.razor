@using System.Globalization
@inject AtProtoUserClientAccessor UserClient
@inject ILogger<ComposePost> Logger

<div class="atproto-compose @CssClass">
    @if (_error is not null)
    {
        <div class="atproto-compose-error" role="alert">@_error</div>
    }

    <form @onsubmit="HandlePostAsync">
        <textarea @bind="_text"
                  @bind:event="oninput"
                  placeholder="@Placeholder"
                  maxlength="3000"
                  rows="@Rows"
                  disabled="@_posting"
                  class="atproto-compose-textarea"></textarea>

        <div class="atproto-compose-footer">
            <span class="atproto-compose-charcount @(Graphemes > MaxGraphemes ? "over" : "")">
                @Graphemes / @MaxGraphemes
            </span>

            <button type="submit"
                    disabled="@(!CanPost)"
                    class="atproto-compose-submit">
                @(_posting ? "Posting…" : "Post")
            </button>
        </div>
    </form>
</div>

@code {
    /// <summary>The most graphemes an <c>app.bsky.feed.post</c> may hold.</summary>
    private const int MaxGraphemes = 300;

    /// <summary>Placeholder text for the compose area.</summary>
    [Parameter] public string Placeholder { get; set; } = "What's happening?";

    /// <summary>Number of visible rows for the textarea.</summary>
    [Parameter] public int Rows { get; set; } = 4;

    /// <summary>Reply reference — set this to compose a reply to a specific post.</summary>
    [Parameter] public ReplyRef? ReplyTo { get; set; }

    /// <summary>Language tags for the post (BCP-47).</summary>
    [Parameter] public List<string>? Langs { get; set; }

    /// <summary>Callback invoked when the post is successfully created.</summary>
    [Parameter] public EventCallback<ATProtoNet.RecordRef> OnPostCreated { get; set; }

    /// <summary>Optional CSS class.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string _text = string.Empty;
    private string? _error;
    private bool _posting;

    private int Graphemes => new StringInfo(_text).LengthInTextElements;

    private bool CanPost => !_posting && !string.IsNullOrWhiteSpace(_text) && Graphemes <= MaxGraphemes;

    private async Task HandlePostAsync()
    {
        if (!CanPost)
            return;

        _posting = true;
        _error = null;

        try
        {
            var client = await UserClient.GetClientAsync();
            if (client is null)
            {
                _error = "Sign in to post.";
                return;
            }

            var result = await client.Bsky.PostAsync(
                _text,
                new PostOptions { Reply = ReplyTo, Langs = Langs });

            _text = string.Empty;
            await OnPostCreated.InvokeAsync(result);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Creating a post failed");
            _error = "Couldn't create the post. Try again.";
        }
        finally
        {
            _posting = false;
        }
    }
}
