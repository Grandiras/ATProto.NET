<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for ATProtoNet — dependency injection, the OAuth cookie login and per-user clients, service auth, XRPC endpoint handlers, the space server, and .NET Aspire client integration for AT Protocol applications. Depends on nothing beyond the ASP.NET Core shared framework.</Description>
    <PackageTags>atproto;bluesky;aspnetcore;at-protocol;dotnet;oauth;aspire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATProtoNet\ATProtoNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ATProtoNet.Tests" />
    <!-- The components find the signed-in user the way the client factory does. -->
    <InternalsVisibleTo Include="ATProtoNet.Blazor" />
    <!-- The EF Core space stores page their lists the way the in-memory ones do (SpacePaging). -->
    <InternalsVisibleTo Include="ATProtoNet.Server.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only dependency beyond the core package: EF Core stores are in
         ATProtoNet.Server.EntityFrameworkCore, and resilience is the application's to add. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
