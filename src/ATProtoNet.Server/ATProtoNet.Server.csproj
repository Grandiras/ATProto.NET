<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for ATProtoNet — dependency injection, authentication, middleware, EF Core and Redis stores, and .NET Aspire client integration (health checks and resilience) for AT Protocol applications.</Description>
    <PackageTags>atproto;bluesky;aspnetcore;at-protocol;dotnet;entityframeworkcore;redis;aspire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATProtoNet\ATProtoNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ATProtoNet.Tests" />
    <!-- The components find the signed-in user the way the client factory does. -->
    <InternalsVisibleTo Include="ATProtoNet.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core token store (merged from ATProtoNet.Server.EntityFrameworkCore) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <!-- Aspire client integration: standard resilience handler (merged from ATProtoNet.Aspire) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Redis-backed space replay store: SET NX is what makes spending a single-use token atomic
         across instances, and no abstraction in the shared framework offers it. -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

</Project>
