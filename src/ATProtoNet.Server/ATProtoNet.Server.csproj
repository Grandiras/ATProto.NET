<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ATProtoNet.Server</RootNamespace>
    <PackageId>ATProtoNet.Server</PackageId>
    <Description>ASP.NET Core integration for ATProtoNet — dependency injection, authentication, middleware, an EF Core token store, and .NET Aspire client integration (health checks and resilience) for AT Protocol applications.</Description>
    <Authors>Grandiras</Authors>
    <PackageTags>atproto;bluesky;aspnetcore;at-protocol;dotnet;entityframeworkcore;aspire</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://git.grandiras.net/Grandiras/ATProto.NET</PackageProjectUrl>
    <RepositoryUrl>https://git.grandiras.net/Grandiras/ATProto.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented public members are a build error, not a warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATProtoNet\ATProtoNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core token store (merged from ATProtoNet.Server.EntityFrameworkCore) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- Aspire client integration: standard resilience handler (merged from ATProtoNet.Aspire) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
  </ItemGroup>

</Project>
