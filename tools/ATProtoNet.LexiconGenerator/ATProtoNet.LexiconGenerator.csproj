<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ATProtoNet.LexiconGenerator</RootNamespace>
    <AssemblyName>ATProtoNet.LexiconGenerator</AssemblyName>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atproto-lexgen</ToolCommandName>
    <PackageId>ATProtoNet.LexiconGenerator</PackageId>
    <Description>Bidirectional code generator for AT Protocol Lexicon schemas: Lexicon JSON ↔ C# classes</Description>
  </PropertyGroup>

</Project>
