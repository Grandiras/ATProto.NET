<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atproto-lexgen</ToolCommandName>
    <Description>Bidirectional code generator for AT Protocol Lexicon schemas: Lexicon JSON ↔ C# classes. Generate C# from Lexicon, Lexicon from C#, and diff schemas for breaking changes.</Description>
    <PackageTags>atproto;lexicon;codegen;schema;at-protocol;dotnet-tool</PackageTags>
  </PropertyGroup>

</Project>
